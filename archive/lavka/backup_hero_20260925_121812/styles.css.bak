:root{
  --paper:#f3ead8;--paper2:#fbf7ef;--ink:#171713;--muted:#716b5f;--gold:#c99135;--line:#d9cbb3;--ok:#2e6f48;--danger:#8a2e2e;
  --shadow:0 14px 38px rgba(32,26,16,.12);--radius:22px;
}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#efe3cf,#f8f1e6 35%,#efe8dc);color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.app-shell{max-width:760px;margin:0 auto;min-height:100vh;padding-bottom:88px}.hero{display:flex;gap:18px;align-items:center;padding:22px 18px 14px}.logo{width:92px;height:92px;object-fit:cover;border-radius:26px;box-shadow:var(--shadow);border:1px solid rgba(0,0,0,.06)}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--gold)}h1{margin:3px 0 6px;font-size:31px;line-height:1}.hero p{margin:0;color:var(--muted);font-size:14px;line-height:1.35}#content{padding:4px 16px 24px}.section{margin:16px 0}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.section-head h2{font-size:20px;margin:0}.muted{color:var(--muted)}.pill-row{display:flex;gap:8px;overflow:auto;padding-bottom:5px}.pill{white-space:normal;border:1px solid var(--line);background:rgba(255,255,255,.55);padding:10px 14px;border-radius:999px;font-weight:700}.pill.active{background:var(--ink);color:white;border-color:var(--ink)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:rgba(255,255,255,.72);border:1px solid rgba(123,102,70,.16);border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 24px rgba(38,29,14,.08)}.product-img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#e9dfcd}.product-body{padding:12px}.product-title{font-weight:800;font-size:15px;min-height:38px}.product-desc{font-size:12px;color:var(--muted);line-height:1.35;min-height:34px;margin:6px 0}.price-row{display:flex;justify-content:space-between;align-items:center;gap:8px}.price{font-size:18px;font-weight:900}.btn{border:0;border-radius:14px;background:var(--ink);color:#fff;padding:11px 14px;font-weight:800}.btn.secondary{background:var(--paper);color:var(--ink);border:1px solid var(--line)}.btn.gold{background:var(--gold);color:#fff}.btn.danger{background:var(--danger)}.btn:disabled{opacity:.45}.panel{background:rgba(255,255,255,.72);border:1px solid rgba(123,102,70,.16);border-radius:var(--radius);padding:16px;box-shadow:0 8px 24px rgba(38,29,14,.07)}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{padding:14px;border-radius:18px;background:var(--paper2);border:1px solid var(--line)}.stat strong{display:block;font-size:20px}.stat span{font-size:11px;color:var(--muted)}.bottom-nav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(760px,100%);display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:rgba(248,242,231,.94);backdrop-filter:blur(18px);padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid rgba(0,0,0,.08);z-index:30}.bottom-nav button{border:0;background:transparent;padding:10px 6px;border-radius:14px;font-weight:800;color:var(--muted)}.bottom-nav button.active{background:var(--ink);color:#fff}.hidden{display:none!important}.cart-line{display:grid;grid-template-columns:62px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.cart-line img{width:62px;height:62px;border-radius:14px;object-fit:cover}.qty{display:flex;gap:6px;align-items:center}.qty button{width:30px;height:30px;border-radius:10px;border:1px solid var(--line);background:white;font-weight:900}.form{display:grid;gap:10px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:800;color:var(--muted)}input,textarea,select{width:100%;padding:12px 13px;border-radius:14px;border:1px solid var(--line);background:#fffdf9;font:inherit;color:var(--ink)}textarea{min-height:90px;resize:vertical}.order{padding:12px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}.badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:var(--paper);font-size:11px;font-weight:800}.ref-link{display:flex;gap:8px}.ref-link input{font-size:12px}.notice{padding:12px 14px;border-radius:16px;background:#fff6dd;border:1px solid #e9d29a;font-size:13px;line-height:1.35}.admin-list{display:grid;gap:10px}.admin-row{background:#fffdf9;border:1px solid var(--line);padding:12px;border-radius:16px;display:flex;justify-content:space-between;gap:12px;align-items:center}.admin-actions{display:flex;gap:6px;flex-wrap:wrap}.modal{position:fixed;inset:0;background:rgba(0,0,0,.44);display:flex;align-items:flex-end;justify-content:center;z-index:99}.modal-card{width:min(760px,100%);max-height:88vh;overflow:auto;background:var(--paper2);border-radius:24px 24px 0 0;padding:18px}.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:100px;background:#171713;color:white;padding:12px 16px;border-radius:14px;z-index:100;box-shadow:var(--shadow)}.empty{text-align:center;padding:34px 18px;color:var(--muted)}@media(max-width:420px){.hero{align-items:flex-start}.logo{width:78px;height:78px}.hero h1{font-size:27px}.grid{gap:9px}.product-body{padding:10px}.stat-grid{grid-template-columns:1fr 1fr}.bottom-nav{grid-template-columns:repeat(4,1fr)} }

/* SHAMAN LIGHT THEME */
:root{
  --bg:#f4ecdc;
  --paper:#fffaf1;
  --green:#49684b;
  --green2:#78906d;
  --gold:#c79332;
  --text:#243126;
  --muted:#6f756d;
}

html,body{
  background:
    radial-gradient(circle at 15% 15%,rgba(199,147,50,.16),transparent 24%),
    radial-gradient(circle at 85% 20%,rgba(73,104,75,.14),transparent 26%),
    linear-gradient(180deg,#f8f1e5 0%,#efe4ce 55%,#e7eee1 100%) !important;
  color:var(--text)!important;
}

.card,.panel,.profile-card,.admin-card,.modal-card,.product-card,.category-card{
  background:rgba(255,250,241,.94)!important;
  border:1px solid rgba(73,104,75,.16)!important;
  box-shadow:0 12px 30px rgba(50,65,50,.10)!important;
  border-radius:24px!important;
}

button,.btn{
  border-radius:15px!important;
}

.bottom-nav{
  background:rgba(250,246,236,.94)!important;
  backdrop-filter:blur(14px);
  border-top:1px solid rgba(73,104,75,.14)!important;
}

.bottom-nav button.active{
  background:#304a34!important;
  color:white!important;
}

h1,h2,h3{
  color:#2d4230!important;
}

input,textarea,select{
  background:#fffdf8!important;
  border:1px solid rgba(73,104,75,.22)!important;
  border-radius:14px!important;
}

/* ===== SHAMAN PREMIUM HOME v2 ===== */

body{
  background:
    radial-gradient(circle at 10% 5%,rgba(213,169,79,.22),transparent 26%),
    radial-gradient(circle at 90% 13%,rgba(83,113,78,.17),transparent 28%),
    linear-gradient(180deg,#f9f2e4 0%,#f2e5ce 50%,#edf1e5 100%);
}

/* Большая природная шапка */
.hero{
  min-height:238px;
  margin:8px 8px 8px;
  padding:22px 18px 72px;
  align-items:flex-start;
  border-radius:28px;
  border:1px solid rgba(66,83,56,.14);
  background:
    radial-gradient(circle at 73% 13%,rgba(222,177,86,.44),transparent 21%),
    linear-gradient(180deg,#fff8e9 0%,#eee2c8 58%,#cbd3bc 100%);
  box-shadow:0 15px 38px rgba(57,49,32,.13);
}

/* горный силуэт */
.hero::before{
  content:"";
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  height:105px;
  opacity:.72;
  background:
    linear-gradient(140deg,transparent 0 22%,#6f8068 22% 39%,transparent 39%),
    linear-gradient(220deg,transparent 0 20%,#445e48 20% 41%,transparent 41%),
    linear-gradient(150deg,transparent 0 36%,#2e4a34 36% 54%,transparent 54%);
  clip-path:polygon(
    0 100%,0 74%,9% 62%,18% 71%,29% 40%,38% 67%,
    51% 23%,61% 64%,72% 43%,84% 67%,100% 49%,100% 100%
  );
}

/* тёплое солнце */
.hero::after{
  content:"";
  position:absolute;
  width:115px;
  height:115px;
  right:8px;
  top:4px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(221,173,79,.28),rgba(221,173,79,0) 70%);
}

/* логотип */
.logo{
  width:106px;
  height:106px;
  padding:3px;
  object-fit:contain;
  border-radius:24px;
  background:rgba(247,237,218,.88);
  border:1px solid rgba(42,55,40,.11);
  box-shadow:0 9px 26px rgba(46,39,25,.13);
}

/* текст бренда */
.hero > div{
  padding-top:2px;
}

.eyebrow{
  margin-bottom:7px;
  color:#b9852e;
  font-size:10px;
  font-weight:900;
  letter-spacing:.14em;
}

h1{
  margin:0 0 8px;
  font-size:31px;
  line-height:1;
  color:#294330;
  text-shadow:0 1px 0 rgba(255,255,255,.3);
}

.hero p{
  color:#60695f;
  font-size:13px;
  line-height:1.4;
  font-weight:650;
}

/* категории как природные плитки */
.pill-row{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
  padding:4px 2px 10px;
  overflow:visible;
}

.pill{
  width:100%;
  min-width:0;
  min-height:92px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:6px;
  padding:12px 10px;
  border-radius:18px;
  color:#445345;
  background:rgba(255,249,237,.88);
  border:1px solid rgba(56,82,57,.13);
  box-shadow:0 5px 16px rgba(55,49,34,.06);

  white-space:normal;
  text-align:center;
  line-height:1.2;
  font-size:14px;
  overflow-wrap:anywhere;
  word-break:normal;
}

.pill::before{
  content:"✦";
  display:block;
  color:#a67829;
  font-size:18px;
  line-height:1;
}

.pill.active{
  color:#fff;
  background:linear-gradient(145deg,#47694a,#294b32);
  border-color:#35583b;
  box-shadow:0 8px 18px rgba(46,74,51,.2);
}

.pill.active::before{
  color:#f0cf87;
}

/* заголовки */
.section-head{
  margin-top:18px;
  margin-bottom:13px;
}

.section-head h2{
  font-size:25px;
  color:#2c4733;
}

.section-head .muted{
  padding:5px 9px;
  border-radius:999px;
  background:rgba(255,250,240,.6);
  font-size:12px;
}

/* пустой каталог */
.empty{
  margin-top:12px;
  padding:34px 20px;
  border:1px dashed rgba(61,86,58,.18);
  border-radius:24px;
  background:rgba(255,250,240,.42);
  color:#74796f;
}

.empty::before{
  content:"🌿";
  display:block;
  margin-bottom:10px;
  font-size:30px;
}

/* нижняя навигация */
.bottom-nav{
  gap:6px;
  padding:7px 9px calc(7px + env(safe-area-inset-bottom));
  background:rgba(252,247,236,.96);
  border-top:1px solid rgba(54,75,52,.12);
  box-shadow:0 -8px 28px rgba(45,42,30,.08);
}

.bottom-nav button{
  min-height:60px;
  padding:6px 2px 5px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:3px;
  font-size:10px;
  color:#6f766d;
  border-radius:16px;
}

.bottom-nav button::before{
  display:block;
  font-size:21px;
  line-height:22px;
  color:inherit;
}

.bottom-nav button[data-tab="shop"]::before{
  content:"⌂";
}

.bottom-nav button[data-tab="cart"]::before{
  content:"▣";
}

.bottom-nav button[data-tab="profile"]::before{
  content:"♙";
}

.bottom-nav button[data-tab="admin"]::before{
  content:"⚙";
}

.bottom-nav button.active{
  color:#fff;
  background:linear-gradient(145deg,#456849,#2d5035);
  box-shadow:0 7px 18px rgba(47,75,52,.18);
}

/* телефон */
@media(max-width:420px){
  .hero{
    min-height:224px;
    padding:18px 14px 67px;
    gap:13px;
  }

  .logo{
    width:92px;
    height:92px;
  }

  h1{
    font-size:27px;
  }

  .hero p{
    font-size:12px;
  }

  .section-head h2{
    font-size:23px;
  }
}
