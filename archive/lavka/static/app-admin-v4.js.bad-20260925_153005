          category_id,
          name,
          description:(clean?clean+'\n\n':'')+marker,
          price,

          stock:Number(old?.stock)>0
            ? Number(old.stock)
            : 999999,

          image_url,

          weight_g:
            unit==='g'
              ? Math.max(1,Math.round(amount))
              : unit==='ml'
                ? Math.max(1,Math.round(amount))
                : Number(old?.weight_g||200),

          length_cm:Number(old?.length_cm||15),
          width_cm:Number(old?.width_cm||20),
          height_cm:Number(old?.height_cm||10),

          active:true
        };

        if(id){

          await api(`/api/admin/products/${id}`,{
            method:'PUT',
            body:JSON.stringify(body)
          });

          kept.push(id);

        }else{

          await api('/api/admin/products',{
            method:'POST',
            body:JSON.stringify(body)
          });
        }
      }

      for(const old of existing){
        if(old.id && !kept.includes(Number(old.id))){
          await api(`/api/admin/products/${old.id}`,{
            method:'DELETE'
          });
        }
      }

      d.remove();
      await boot();

      toast('Сохранено');

    }catch(e){
      toast(e.message);
    }
  };

  if(p.id){
    $('#delP').onclick=async()=>{

      if(!confirm('Удалить товар?')) return;

      for(const item of existing){
        if(item.id){
          await api(`/api/admin/products/${item.id}`,{
            method:'DELETE'
          });
        }
      }

      d.remove();
      await boot();
    };
  }
};


/* LAVKA_DELETE_PRODUCT_V1 */

const lavkaBindBeforeDeleteV1 = bind;

bind = function(){

  lavkaBindBeforeDeleteV1();

  document.querySelectorAll('[data-edit-product]').forEach(editBtn => {

    const row = editBtn.closest('.admin-row');
    if(!row) return;

    const actions =
      editBtn.closest('.admin-actions') ||
      row;

    if(actions.querySelector('.lavka-delete-product')){
      return;
    }

    const del = document.createElement('button');

    del.className = 'btn danger lavka-delete-product';
    del.textContent = 'Удалить';
    del.type = 'button';

    del.onclick = async () => {

      const id = Number(editBtn.dataset.editProduct);

      const product = (state.boot.products || []).find(
        p => Number(p.id) === id
      );

      if(!product){
        toast('Товар не найден');
        return;
      }

      let ids = [id];

      /*
        Если это товар с вариантами,
        удаляем все его варианты вместе.
      */
      if(typeof lv4meta === 'function'){

        const meta = lv4meta(product);

        if(meta.group){

          ids = (state.boot.products || [])
            .filter(p => lv4meta(p).group === meta.group)
            .map(p => Number(p.id));
        }
      }

      if(!confirm(
        ids.length > 1
          ? `Удалить товар полностью и все его варианты (${ids.length})?`
          : `Удалить товар "${product.name}"?`
      )){
        return;
      }

      try{

        for(const productId of ids){

          await api(
            `/api/admin/products/${productId}`,
            {method:'DELETE'}
          );
        }

        await boot();

        toast('Товар удалён');

      }catch(e){

        toast(e.message);
      }
    };

    actions.appendChild(del);
  });
};

