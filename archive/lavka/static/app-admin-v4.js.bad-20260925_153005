function categoryModal(c={}){

  const currentParent = c.id ? categoryParent(c) : null;

  const possibleParents = sortedCategories().filter(x => {
    if(!c.id) return true;

    if(Number(x.id) === Number(c.id)) return false;

    if(
      c.slug &&
      String(x.slug || '').startsWith(String(c.slug) + '--')
    ){
      return false;
    }

    return true;
  });

  const parentOptions = possibleParents.map(x => `
    <option
      value="${x.id}"
      ${currentParent && Number(currentParent.id)===Number(x.id)?'selected':''}>
      ${'↳ '.repeat(Math.max(0,categoryDepth(x)-1))}${esc(x.name)}
    </option>
  `).join('');

  const d = modal(`
    <div class="section-head">
      <h2>${c.id?'Категория':'Новая категория'}</h2>
      <button class="btn secondary" id="closeM">Закрыть</button>
    </div>

    <div class="form">

      <div class="field">
        <label>Название</label>
        <input
          id="cName"
          value="${esc(c.name||'')}"
          placeholder="Например: Сома">
      </div>

      <div class="field">
        <label>Родительская категория</label>

        <select id="cParent">
          <option value="">Главная категория</option>
          ${parentOptions}
        </select>

        <div class="muted" style="margin-top:6px">
          Если оставить пустым — категория будет главной.
        </div>
      </div>

      <div class="field">
        <label>Slug</label>
        <input
          id="cSlug"
          value="${esc(categoryBaseSlug(c))}"
          placeholder="создаётся автоматически">
      </div>

      <div class="field">
        <label>Порядок</label>
        <input
          id="cSort"
          type="number"
          value="${c.sort_order??0}">
      </div>

      <button class="btn gold" id="saveC">
        Сохранить
      </button>

    </div>
  `);

  $('#closeM').onclick = () => d.remove();

  $('#saveC').onclick = async () => {
    try{

      const name = $('#cName').value.trim();

      if(!name){
        throw new Error('Укажи название категории');
      }

      let baseSlug = $('#cSlug').value.trim();

      baseSlug = baseSlug
        .replace(/--+/g,'-')
        .replace(/^-+|-+$/g,'');

      if(!baseSlug){
        throw new Error('Slug не создан');
      }

      const parentId = $('#cParent').value
        ? Number($('#cParent').value)
        : null;

      const parent = parentId
        ? state.boot.categories.find(x =>
            Number(x.id) === Number(parentId)
          )
        : null;

      const fullSlug = parent
        ? `${parent.slug}--${baseSlug}`
        : baseSlug;

      const oldSlug = String(c.slug || '');

      const body = {
        name,
        slug: fullSlug,
        sort_order: Number($('#cSort').value || 0),
        active: true
      };

      await api(
        c.id
          ? `/api/admin/categories/${c.id}`
          : '/api/admin/categories',
        {
          method: c.id ? 'PUT' : 'POST',
          body: JSON.stringify(body)
        }
      );

      /*
        Если поменяли slug родительской категории,
        автоматически обновляем пути её подразделов.
      */
      if(c.id && oldSlug && oldSlug !== fullSlug){

        const descendants = state.boot.categories.filter(x =>
          Number(x.id) !== Number(c.id) &&
          String(x.slug || '').startsWith(oldSlug + '--')
        );

        for(const child of descendants){

          const childSlug =
            fullSlug +
            String(child.slug).slice(oldSlug.length);

          await api(
            `/api/admin/categories/${child.id}`,
            {
              method:'PUT',
              body:JSON.stringify({
                name: child.name,
                slug: childSlug,
                sort_order: Number(child.sort_order || 0),
                active: child.active !== false
              })
            }
          );
        }
      }

      d.remove();
      await boot();
      toast('Категория сохранена');

    }catch(e){
      toast(e.message);
    }
  };
}

