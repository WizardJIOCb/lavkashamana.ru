function productModal(p={}){
  function readMeta(prod){
    const raw=String(prod?.description||'');
    const m=raw.match(/\[\[VARIANT:([^|\]]+)\|([0-9.]+)\|(g|ml|pcs)\]\]/);

    if(!m){
      return {
        group:null,
        amount:prod?.weight_g||'',
        unit:'g',
        description:raw
      };
    }

    return {
      group:m[1],
      amount:Number(m[2]),
      unit:m[3],
      description:raw.replace(m[0],'').trim()
    };
  }

  const firstMeta=p.id?readMeta(p):null;
  const group=firstMeta?.group || ('grp_'+Date.now());

  let items=[];

  if(p.id && firstMeta?.group){
    items=state.boot.products.filter(x=>{
      const m=readMeta(x);
      return m.group===firstMeta.group;
    });
  }else if(p.id){
    items=[p];
  }

  const first=items[0]||p||{};
  const cleanDescription=p.id?readMeta(first).description:'';

  function variantRow(item={}){
    const m=item.id
      ? readMeta(item)
      : {amount:'',unit:'g'};

    return `
      <div class="panel variant-row"
           data-id="${item.id||''}"
           style="padding:12px;margin-bottom:12px">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">

          <div class="field">
            <label>Количество</label>
            <input class="vAmount"
                   type="number"
                   min="0.01"
                   step="0.01"
                   value="${m.amount??''}"
                   placeholder="Например 330">
          </div>

          <div class="field">
            <label>Единица</label>
            <select class="vUnit">
              <option value="g" ${m.unit==='g'?'selected':''}>граммы</option>
              <option value="ml" ${m.unit==='ml'?'selected':''}>миллилитры</option>
              <option value="pcs" ${m.unit==='pcs'?'selected':''}>штуки</option>
            </select>
          </div>

        </div>

        <div class="field">
          <label>Цена, ₽</label>
          <input class="vPrice"
                 type="number"
                 min="0"
                 value="${item.price??0}">
        </div>

        <button class="btn secondary removeVariant" type="button">
          Удалить вариант
        </button>
      </div>
    `;
  }

  const cats=(
    typeof sortedCategories==='function'
      ? sortedCategories()
      : state.boot.categories
  );

  const d=modal(`
    <div class="section-head">
      <h2>${p.id?'Редактировать товар':'Новый товар'}</h2>
      <button class="btn secondary" id="closeM">Закрыть</button>
    </div>

    <div class="form">

      <div class="field">
        <label>Название</label>
        <input id="pName" value="${esc(first.name||'')}">
      </div>

      <div class="field">
        <label>Категория</label>
        <select id="pCat">
          <option value="">Без категории</option>
          ${cats.map(c=>`
            <option value="${c.id}" ${first.category_id==c.id?'selected':''}>
              ${typeof categoryDepth==='function'?'↳ '.repeat(Math.max(0,categoryDepth(c)-1)):''}${esc(c.name)}
            </option>
          `).join('')}
        </select>
      </div>

      <div class="field">
        <label>Описание</label>
        <textarea id="pDesc">${esc(cleanDescription)}</textarea>
      </div>

      <div class="field">
        <label>Фото</label>
        <input id="pImg"
               value="${esc(first.image_url||'')}"
               placeholder="Ссылка или загруженный файл">

        <input id="pFile"
               type="file"
               accept="image/jpeg,image/png,image/webp">

        <button class="btn secondary" id="uploadP" type="button">
          Загрузить фото
        </button>
      </div>

      <div class="section-head" style="margin-top:14px">
        <h3>Варианты товара</h3>
        <button class="btn secondary" id="addVariant" type="button">
          + Вариант
        </button>
      </div>

      <div id="variantRows">
        ${items.length ? items.map(variantRow).join('') : variantRow()}
      </div>

      <button class="btn gold" id="saveP">
        Сохранить
      </button>

      ${p.id?'<button class="btn danger" id="delP">Удалить товар</button>':''}
    </div>
  `);

  $('#closeM').onclick=()=>d.remove();

  function bindRemove(){
    d.querySelectorAll('.removeVariant').forEach(btn=>{
      btn.onclick=()=>{
        if(d.querySelectorAll('.variant-row').length<=1){
          toast('Нужен хотя бы один вариант');
          return;
        }
        btn.closest('.variant-row').remove();
      };
    });
  }

  bindRemove();

  $('#addVariant').onclick=()=>{
    $('#variantRows').insertAdjacentHTML('beforeend',variantRow());
    bindRemove();
  };

  $('#uploadP').onclick=async()=>{
    try{
      const f=$('#pFile').files[0];
      if(!f) throw new Error('Выбери файл');

      const fd=new FormData();
      fd.append('file',f);

      const h=authHeaders();
      delete h['Content-Type'];

      const r=await fetch('/api/admin/upload',{
        method:'POST',
        headers:h,
        body:fd
      });

      if(!r.ok){
        throw new Error((await r.json()).detail||'Ошибка загрузки');
      }

      const out=await r.json();
      $('#pImg').value=out.url;
      toast('Фото загружено');

    }catch(e){
      toast(e.message);
    }
  };

  $('#saveP').onclick=async()=>{
    try{
      const name=$('#pName').value.trim();
      if(!name) throw new Error('Укажи название');

      const category_id=$('#pCat').value
        ? Number($('#pCat').value)
        : null;

      const description=$('#pDesc').value.trim();
      const image_url=$('#pImg').value.trim();

      const rows=[...d.querySelectorAll('.variant-row')];
      const keep=[];

      for(const row of rows){
        const amount=Number(row.querySelector('.vAmount').value);
        const unit=row.querySelector('.vUnit').value;
        const price=Number(row.querySelector('.vPrice').value);

        if(!amount || amount<=0){
          throw new Error('Укажи количество');
        }

        const id=Number(row.dataset.id||0)||null;

        const old=id
          ? state.boot.products.find(x=>Number(x.id)===id)
          : null;

        const marker=`[[VARIANT:${group}|${amount}|${unit}]]`;

        const body={
          category_id,
          name,
          description:(description?description+'\n\n':'')+marker,
          price,

          stock:Number(old?.stock)>0
            ? Number(old.stock)
            : 999999,

          image_url,

          weight_g:
            unit==='g' ? Math.round(amount)
            : unit==='ml' ? Math.round(amount)
            : Number(old?.weight_g||200),

          length_cm:Number(old?.length_cm||15),
          width_cm:Number(old?.width_cm||20),
          height_cm:Number(old?.height_cm||10),

          active:true
        };

        if(id){
          await api(`/api/admin/products/${id}`,{
            method:'PUT',
            body:JSON.stringify(body)
          });

          keep.push(id);
        }else{
          await api('/api/admin/products',{
            method:'POST',
            body:JSON.stringify(body)
          });
        }
      }

      for(const old of items){
        if(old.id && !keep.includes(Number(old.id))){
          await api(`/api/admin/products/${old.id}`,{
            method:'DELETE'
          });
        }
      }

      d.remove();
      await boot();
      toast('Сохранено');

    }catch(e){
      toast(e.message);
    }
  };

  if(p.id){
    $('#delP').onclick=async()=>{
      if(!confirm('Удалить товар?')) return;

      for(const item of items){
        await api(`/api/admin/products/${item.id}`,{
          method:'DELETE'
        });
      }

      d.remove();
      await boot();
    };
  }
}



