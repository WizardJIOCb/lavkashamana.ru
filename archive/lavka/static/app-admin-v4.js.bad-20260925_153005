/* LAVKA_NESTED_CATEGORIES_V1 */

function categoryDepth(c){
  return String(c?.slug || '').split('--').filter(Boolean).length || 1;
}

function categoryParent(c){
  const slug = String(c?.slug || '');
  if(!slug.includes('--')) return null;

  const parentSlug = slug.split('--').slice(0,-1).join('--');

  return (state.boot?.categories || []).find(x =>
    String(x.slug || '') === parentSlug
  ) || null;
}

function categoryRoot(c){
  let cur = c;
  let p;

  while(cur && (p = categoryParent(cur))){
    cur = p;
  }

  return cur;
}

function categoryChildren(c){
  if(!c) return [];

  const prefix = String(c.slug || '') + '--';

  return (state.boot?.categories || []).filter(x => {
    const slug = String(x.slug || '');

    if(!slug.startsWith(prefix)) return false;

    const rest = slug.slice(prefix.length);

    return rest && !rest.includes('--');
  });
}

function categoryDescendantIds(c){
  if(!c) return [];

  const slug = String(c.slug || '');
  const prefix = slug + '--';

  return (state.boot?.categories || [])
    .filter(x => {
      const xs = String(x.slug || '');
      return xs === slug || xs.startsWith(prefix);
    })
    .map(x => Number(x.id));
}

function categoryBaseSlug(c){
  const slug = String(c?.slug || '');
  return slug.split('--').filter(Boolean).pop() || '';
}

function sortedCategories(){
  return [...(state.boot?.categories || [])].sort((a,b) => {
    const da = categoryDepth(a);
    const db = categoryDepth(b);

    if(da !== db) return da - db;

    return String(a.slug || '').localeCompare(
      String(b.slug || ''),
      'ru'
    );
  });
}

function shopView(){
  const cats = state.boot.categories || [];
  const roots = cats.filter(c => categoryDepth(c) === 1);

  const selected =
    state.category === 'all'
      ? null
      : cats.find(c => String(c.id) === String(state.category));

  const root = selected ? categoryRoot(selected) : null;

  const firstRow = `
    <div class="pill-row">
      <button class="pill ${state.category==='all'?'active':''}" data-cat="all">
        Все
      </button>

      ${roots.map(c => `
        <button
          class="pill ${root && String(root.id)===String(c.id)?'active':''}"
          data-cat="${c.id}">
          ${esc(c.name)}
        </button>
      `).join('')}
    </div>
  `;

  let subRows = '';

  if(root){
    const children = categoryChildren(root);

    if(children.length){
      subRows += `
        <div class="pill-row" style="margin-top:10px">
          <button
            class="pill ${String(state.category)===String(root.id)?'active':''}"
            data-cat="${root.id}">
            Все ${esc(root.name)}
          </button>

          ${children.map(c => `
            <button
              class="pill ${String(state.category)===String(c.id)?'active':''}"
              data-cat="${c.id}">
              ${esc(c.name)}
            </button>
          `).join('')}
        </div>
      `;
    }

    if(selected && selected.id !== root.id){
      const level3 = categoryChildren(selected);

      if(level3.length){
        subRows += `
          <div class="pill-row" style="margin-top:10px">
            ${level3.map(c => `
              <button
                class="pill ${String(state.category)===String(c.id)?'active':''}"
                data-cat="${c.id}">
                ${esc(c.name)}
              </button>
            `).join('')}
          </div>
        `;
      }
    }
  }

  let products = state.boot.products;

  if(selected){
    const ids = categoryDescendantIds(selected);

    products = products.filter(p =>
      ids.includes(Number(p.category_id))
    );
  }

  return `
    <section class="section">
      ${firstRow}
      ${subRows}
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Каталог</h2>
        <span class="muted">${products.length} поз.</span>
      </div>

      ${
        products.length
          ? `<div class="grid">
              ${products.map(p => `
                <article class="card">
                  <img
                    class="product-img"
                    src="${esc(p.image_url||'/logo.jpg')}"
                    onerror="this.src='/logo.jpg'">

                  <div class="product-body">
                    <div class="product-title">${esc(lavkaDisplayName(p))}</div>
                    <div class="product-desc">${esc(lavkaDisplayMeta(p).description)}</div>

                    <div class="price-row">
                      <div>
                        <div class="price">${rub(p.price)}</div>
                        
                      </div>

                      <button
                        class="btn gold"
                        data-add="${p.id}"
                        ${p.stock<1?'disabled':''}>
                        +
                      </button>
                    </div>
                  </div>
                </article>
              `).join('')}
            </div>`
          : `<div class="empty">
              В этой категории пока нет товаров.
            </div>`
      }
    </section>
  `;
}

