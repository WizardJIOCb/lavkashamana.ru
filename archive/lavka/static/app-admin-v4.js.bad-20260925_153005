/* LAVKA_AUTO_CATEGORY_SLUG_V1 */
(() => {
  const ru = {
    а:'a',б:'b',в:'v',г:'g',д:'d',е:'e',ё:'e',ж:'zh',з:'z',
    и:'i',й:'i',к:'k',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',
    с:'s',т:'t',у:'u',ф:'f',х:'h',ц:'c',ч:'ch',ш:'sh',
    щ:'sch',ъ:'',ы:'y',ь:'',э:'e',ю:'yu',я:'ya'
  };

  function categorySlug(value) {
    return String(value || '')
      .trim()
      .toLowerCase()
      .split('')
      .map(ch => ru[ch] !== undefined ? ru[ch] : ch)
      .join('')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function findSlug(scope) {
    return scope.querySelector(
      'input[name="slug"], input[id="slug"], input[id*="slug"], input[name*="slug"]'
    );
  }

  function updateSlugFromInput(input) {
    if (!input || input.tagName !== 'INPUT') return;

    const scope =
      input.closest('form') ||
      input.closest('.modal') ||
      input.closest('.dialog') ||
      input.closest('.sheet') ||
      input.parentElement?.parentElement ||
      document;

    const slugInput = findSlug(scope);
    if (!slugInput || slugInput === input) return;

    const key = ((input.name || '') + ' ' + (input.id || '')).toLowerCase();
    const placeholder = (input.placeholder || '').toLowerCase();

    const looksLikeName =
      key === 'name ' ||
      key.trim() === 'name' ||
      key.trim() === 'title' ||
      key.includes('category') ||
      key.includes('name') ||
      placeholder.includes('название') ||
      placeholder.includes('категор');

    if (!looksLikeName) return;

    const slug = categorySlug(input.value);

    if (slugInput.value !== slug) {
      slugInput.value = slug;
      slugInput.dispatchEvent(new Event('input', { bubbles: true }));
      slugInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  document.addEventListener('input', e => {
    updateSlugFromInput(e.target);
  }, true);

  /*
    Дополнительная страховка:
    перед отправкой категории slug добавляется в JSON автоматически,
    даже если поле формы по какой-то причине не заполнилось.
  */
  const originalFetch = window.fetch;

  window.fetch = function(input, init) {
    try {
      const url =
        typeof input === 'string'
          ? input
          : (input && input.url ? input.url : '');

      const opts = init ? { ...init } : {};
      const method = String(
        opts.method ||
        (input && input.method) ||
        'GET'
      ).toUpperCase();

      if (
        /categor/i.test(url) &&
        ['POST', 'PUT', 'PATCH'].includes(method) &&
        typeof opts.body === 'string'
      ) {
        try {
          const data = JSON.parse(opts.body);

          const name =
            data.name ||
            data.title ||
            data.category_name;

          if (name && (!data.slug || !String(data.slug).trim())) {
            data.slug = categorySlug(name);
            opts.body = JSON.stringify(data);
          }
        } catch (_) {}
      }

      return originalFetch.call(this, input, opts);
    } catch (_) {
      return originalFetch.call(this, input, init);
    }
  };
})();


/* LAVKA_FORCE_VARIANTS_V4 */

function lv4meta(p){
  const raw=String(p?.description||'');
  const m=raw.match(/\[\[LV4:([^|\]]+)\|([0-9.]+)\|(g|ml|pcs)\]\]/);

  if(!m){
    return {
      group:null,
      amount:p?.weight_g||'',
      unit:'g',
      description:raw
    };
  }

  return {
    group:m[1],
    amount:Number(m[2]),
    unit:m[3],
    description:raw.replace(m[0],'').trim()
  };
}

function lv4group(){
  return 'vg_'+Date.now()+'_'+Math.random().toString(36).slice(2,7);
}

