        </span>
      </label>

      <button class="btn" id="privacyContinueBtn" disabled>
        Продолжить
      </button>

      <button class="privacy-link" id="privacyOpenInfo">
        Открыть документы
      </button>

    </div>
  `;

  document.body.appendChild(gate);

  const check = gate.querySelector('#privacyConsentCheck');
  const btn = gate.querySelector('#privacyContinueBtn');

  check.addEventListener('change', () => {
    btn.disabled = !check.checked;
  });

  btn.addEventListener('click', () => {
    if (!check.checked) return;

    localStorage.setItem(
      'lavka_privacy_consent_v1',
      JSON.stringify({
        accepted: true,
        date: new Date().toISOString(),
        version: 1
      })
    );

    gate.remove();
  });

  gate.querySelector('#privacyOpenInfo').addEventListener('click', () => {
    state.tab = 'info';
    render();
    gate.remove();
  });
}

