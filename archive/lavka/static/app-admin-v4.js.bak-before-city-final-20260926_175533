/* LAVKA_AUTO_CATEGORY_SLUG_V1 */
(() => {
  const ru = {
    а:'a',б:'b',в:'v',г:'g',д:'d',е:'e',ё:'e',ж:'zh',з:'z',
    и:'i',й:'i',к:'k',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',
    с:'s',т:'t',у:'u',ф:'f',х:'h',ц:'c',ч:'ch',ш:'sh',
    щ:'sch',ъ:'',ы:'y',ь:'',э:'e',ю:'yu',я:'ya'
  };

  function categorySlug(value) {
    return String(value || '')
      .trim()
      .toLowerCase()
      .split('')
      .map(ch => ru[ch] !== undefined ? ru[ch] : ch)
      .join('')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function findSlug(scope) {
    return scope.querySelector(
      'input[name="slug"], input[id="slug"], input[id*="slug"], input[name*="slug"]'
    );
  }

  function updateSlugFromInput(input) {
    if (!input || input.tagName !== 'INPUT') return;

    const scope =
      input.closest('form') ||
      input.closest('.modal') ||
      input.closest('.dialog') ||
      input.closest('.sheet') ||
      input.parentElement?.parentElement ||
      document;

    const slugInput = findSlug(scope);
    if (!slugInput || slugInput === input) return;

    const key = ((input.name || '') + ' ' + (input.id || '')).toLowerCase();
    const placeholder = (input.placeholder || '').toLowerCase();

    const looksLikeName =
      key === 'name ' ||
      key.trim() === 'name' ||
      key.trim() === 'title' ||
      key.includes('category') ||
      key.includes('name') ||
      placeholder.includes('название') ||
      placeholder.includes('категор');

    if (!looksLikeName) return;

    const slug = categorySlug(input.value);

    if (slugInput.value !== slug) {
      slugInput.value = slug;
      slugInput.dispatchEvent(new Event('input', { bubbles: true }));
      slugInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  document.addEventListener('input', e => {
    updateSlugFromInput(e.target);
  }, true);

  /*
    Дополнительная страховка:
    перед отправкой категории slug добавляется в JSON автоматически,
    даже если поле формы по какой-то причине не заполнилось.
  */
  const originalFetch = window.fetch;

  window.fetch = function(input, init) {
    try {
      const url =
        typeof input === 'string'
          ? input
          : (input && input.url ? input.url : '');

      const opts = init ? { ...init } : {};
      const method = String(
        opts.method ||
        (input && input.method) ||
        'GET'
      ).toUpperCase();

      if (
        /categor/i.test(url) &&
        ['POST', 'PUT', 'PATCH'].includes(method) &&
        typeof opts.body === 'string'
      ) {
        try {
          const data = JSON.parse(opts.body);

          const name =
            data.name ||
            data.title ||
            data.category_name;

          if (name && (!data.slug || !String(data.slug).trim())) {
            data.slug = categorySlug(name);
            opts.body = JSON.stringify(data);
          }
        } catch (_) {}
      }

      return originalFetch.call(this, input, opts);
    } catch (_) {
      return originalFetch.call(this, input, init);
    }
  };
})();


/* LAVKA_FORCE_VARIANTS_V4 */

function lv4meta(p){
  const raw=String(p?.description||'');

  const sm=raw.match(/\[\[SHORT:([^\]]*)\]\]/);

  let short='';
  if(sm){
    try{
      short=decodeURIComponent(sm[1]);
    }catch(_){
      short=sm[1];
    }
  }

  const cleaned=sm
    ? raw.replace(sm[0],'').trim()
    : raw;

  const m=cleaned.match(/\[\[LV4:([^|\]]+)\|([0-9.]+)\|(g|ml|pcs)\]\]/);

  if(!m){
    return {
      group:null,
      amount:p?.weight_g||'',
      unit:'g',
      short,
      description:cleaned
    };
  }

  return {
    group:m[1],
    amount:Number(m[2]),
    unit:m[3],
    short,
    description:cleaned.replace(m[0],'').trim()
  };
}

function lv4group(){
  return 'vg_'+Date.now()+'_'+Math.random().toString(36).slice(2,7);
}

productModal = function(p={}){

  const pm=p.id?lv4meta(p):null;
  const group=pm?.group||lv4group();

  let existing=[];

  if(p.id && pm?.group){
    existing=state.boot.products.filter(x=>lv4meta(x).group===group);
  }else if(p.id){
    existing=[p];
  }

  const first=existing[0]||p||{};
  const description=p.id?lv4meta(first).description:'';
  const shortText=p.id?lv4meta(first).short:'';

  function row(item={}){
    const m=item.id
      ? lv4meta(item)
      : {amount:'',unit:'g'};

    return `
      <div class="panel lv4row" data-id="${item.id||''}"
           style="padding:12px;margin-bottom:12px">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">

          <div class="field">
            <label>Количество</label>
            <input class="lv4amount"
                   type="number"
                   min="0.01"
                   step="0.01"
                   value="${m.amount??''}"
                   placeholder="330">
          </div>

          <div class="field">
            <label>Единица</label>
            <select class="lv4unit">
              <option value="g" ${m.unit==='g'?'selected':''}>граммы</option>
              <option value="ml" ${m.unit==='ml'?'selected':''}>миллилитры</option>
              <option value="pcs" ${m.unit==='pcs'?'selected':''}>штуки</option>
            </select>
          </div>

        </div>

        <div class="field">
          <label>Цена, ₽</label>
          <input class="lv4price"
                 type="number"
                 min="0"
                 value="${item.price??0}">
        </div>

        <button type="button"
                class="btn secondary lv4remove">
          Удалить вариант
        </button>

      </div>
    `;
  }

  const cats =
    typeof sortedCategories==='function'
      ? sortedCategories()
      : state.boot.categories;

  const d=modal(`

    <div class="section-head">
      <h2>${p.id?'Редактировать товар':'Новый товар'}</h2>
      <button class="btn secondary" id="closeM">Закрыть</button>
    </div>

    <div class="form">

      <div class="field">
        <label>Название</label>
        <input id="pName" value="${esc(first.name||'')}">
      </div>

      <div class="field">
        <label>Категория</label>
        <select id="pCat">
          <option value="">Без категории</option>

          ${cats.map(c=>`
            <option value="${c.id}"
              ${first.category_id==c.id?'selected':''}>
              ${
                typeof categoryDepth==='function'
                  ? '↳ '.repeat(Math.max(0,categoryDepth(c)-1))
                  : ''
              }${esc(c.name)}
            </option>
          `).join('')}

        </select>
      </div>

      <div class="field">
        <label>Кратко о товаре</label>
        <textarea
          id="pShort"
          rows="3"
          maxlength="220"
          placeholder="Например: Для гармонии, спокойствия, медитации и практик."
        >${esc(shortText)}</textarea>
      </div>

      <div class="field">
        <label>Подробное описание</label>
        <textarea
          id="pDesc"
          style="min-height:180px"
          placeholder="Полная информация о товаре"
        >${esc(description)}</textarea>
      </div>

      <div class="field">
        <label>Фото</label>

        <input id="pImg"
               value="${esc(first.image_url||'')}"
               placeholder="Ссылка или загруженный файл">

        <input id="pFile"
               type="file"
               accept="image/jpeg,image/png,image/webp">

        <button class="btn secondary"
                id="uploadP"
                type="button">
          Загрузить фото
        </button>
      </div>

      <div class="section-head" style="margin-top:12px">
        <h3>Варианты товара</h3>

        <button class="btn secondary"
                id="addVariant"
                type="button">
          + Вариант
        </button>
      </div>

      <div id="lv4rows">
        ${existing.length ? existing.map(row).join('') : row()}
      </div>

      <button class="btn gold" id="saveP">
        Сохранить
      </button>

      ${p.id
        ? '<button class="btn danger" id="delP">Удалить товар</button>'
        : ''
      }

    </div>
  `);

  $('#closeM').onclick=()=>d.remove();

  function bindRemove(){
    d.querySelectorAll('.lv4remove').forEach(btn=>{
      btn.onclick=()=>{
        if(d.querySelectorAll('.lv4row').length===1){
          toast('Нужен хотя бы один вариант');
          return;
        }

        btn.closest('.lv4row').remove();
      };
    });
  }

  bindRemove();

  $('#addVariant').onclick=()=>{
    $('#lv4rows').insertAdjacentHTML('beforeend',row());
    bindRemove();
  };

  $('#uploadP').onclick=async()=>{
    try{
      const f=$('#pFile').files[0];

      if(!f) throw new Error('Выбери файл');

      const fd=new FormData();
      fd.append('file',f);

      const h=authHeaders();
      delete h['Content-Type'];

      const r=await fetch('/api/admin/upload',{
        method:'POST',
        headers:h,
        body:fd
      });

      if(!r.ok){
        throw new Error((await r.json()).detail||'Ошибка загрузки');
      }

      const out=await r.json();
      $('#pImg').value=out.url;

      toast('Фото загружено');

    }catch(e){
      toast(e.message);
    }
  };

  $('#saveP').onclick=async()=>{
    try{

      const name=$('#pName').value.trim();

      if(!name){
        throw new Error('Укажи название товара');
      }

      const category_id=$('#pCat').value
        ? Number($('#pCat').value)
        : null;

      const shortText=$('#pShort').value.trim();
      const clean=$('#pDesc').value.trim();
      const image_url=$('#pImg').value.trim();

      const rows=[...d.querySelectorAll('.lv4row')];
      const kept=[];

      for(const r of rows){

        const amount=Number(
          r.querySelector('.lv4amount').value
        );

        const unit=
          r.querySelector('.lv4unit').value;

        const price=Number(
          r.querySelector('.lv4price').value
        );

        if(!amount || amount<=0){
          throw new Error('Укажи количество');
        }

        const id=Number(r.dataset.id||0)||null;

        const old=id
          ? state.boot.products.find(x=>Number(x.id)===id)
          : null;

        const marker=`[[LV4:${group}|${amount}|${unit}]]`;
        const shortMarker=shortText
          ? `[[SHORT:${encodeURIComponent(shortText)}]]`
          : '';

        const body={
          category_id,
          name,
          description:(shortMarker?shortMarker+'\n':'')+(clean?clean+'\n\n':'')+marker,
          price,

          stock:Number(old?.stock)>0
            ? Number(old.stock)
            : 999999,

          image_url,

          weight_g:
            unit==='g'
              ? Math.max(1,Math.round(amount))
              : unit==='ml'
                ? Math.max(1,Math.round(amount))
                : Number(old?.weight_g||200),

          length_cm:Number(old?.length_cm||15),
          width_cm:Number(old?.width_cm||20),
          height_cm:Number(old?.height_cm||10),

          active:true
        };

        if(id){

          await api(`/api/admin/products/${id}`,{
            method:'PUT',
            body:JSON.stringify(body)
          });

          kept.push(id);

        }else{

          await api('/api/admin/products',{
            method:'POST',
            body:JSON.stringify(body)
          });
        }
      }

      for(const old of existing){
        if(old.id && !kept.includes(Number(old.id))){
          await api(`/api/admin/products/${old.id}`,{
            method:'DELETE'
          });
        }
      }

      d.remove();
      await boot();

      toast('Сохранено');

    }catch(e){
      toast(e.message);
    }
  };

  if(p.id){
    $('#delP').onclick=async()=>{

      if(!confirm('Удалить товар?')) return;

      for(const item of existing){
        if(item.id){
          await api(`/api/admin/products/${item.id}`,{
            method:'DELETE'
          });
        }
      }

      d.remove();
      await boot();
    };
  }
};


