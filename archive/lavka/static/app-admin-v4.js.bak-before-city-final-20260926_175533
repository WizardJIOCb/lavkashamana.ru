function lavkaOrderStatus(status){
  const s = String(status || '').toLowerCase();

  if(s === 'paid'){
    return {
      key:'paid',
      text:'Оплачен',
      cls:'lavka-status-paid'
    };
  }

  if(
    s === 'cancelled' ||
    s === 'canceled'
  ){
    return {
      key:'cancelled',
      text:'Отменён',
      cls:'lavka-status-cancelled'
    };
  }

  if(
    s === 'failed' ||
    s === 'payment_failed'
  ){
    return {
      key:'cancelled',
      text:'Ошибка оплаты',
      cls:'lavka-status-cancelled'
    };
  }

  return {
    key:'pending',
    text:'Ожидает оплаты',
    cls:'lavka-status-pending'
  };
}

