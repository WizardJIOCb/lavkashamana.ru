window.lavkaVariantChoice = window.lavkaVariantChoice || {};

function lv4ShopLabel(meta){
  if(!meta) return '';

  let amount = Number(meta.amount);
  let unit = meta.unit;

  if(unit === 'ml' && amount >= 1000){
    const liters = amount / 1000;
    const txt = Number.isInteger(liters)
      ? String(liters)
      : String(liters).replace('.', ',');
    return txt + ' л';
  }

  const txt = Number.isInteger(amount)
    ? String(amount)
    : String(amount).replace('.', ',');

  const units = {
    g: 'г',
    ml: 'мл',
    pcs: 'шт.'
  };

  return txt + ' ' + (units[unit] || unit);
}

function lv4ApplyGroupedStorefront(){
  if(!state.boot || state.tab !== 'shop') return;

  const grid = document.querySelector('#content .grid');
  if(!grid) return;

  const cards = [...grid.querySelectorAll('.card')];
  const grouped = new Map();

  cards.forEach(card => {
    const add = card.querySelector('[data-add]');
    if(!add) return;

    const p = state.boot.products.find(
      x => String(x.id) === String(add.dataset.add)
    );

    if(!p) return;

    const meta = lv4meta(p);
    const key = meta.group
      ? 'group:' + meta.group
      : 'single:' + p.id;

    if(!grouped.has(key)){
      grouped.set(key, []);
    }

    grouped.get(key).push({card, product:p, meta});
  });

  grouped.forEach((items, key) => {
    if(!key.startsWith('group:') || items.length < 2) return;

    items.sort((a,b) => {
      const aa = Number(a.meta.amount || 0);
      const bb = Number(b.meta.amount || 0);
      return aa - bb;
    });

    const group = key.slice(6);

    let selectedId = window.lavkaVariantChoice[group];

    let selectedIndex = items.findIndex(
      x => String(x.product.id) === String(selectedId)
    );

    if(selectedIndex < 0){
      selectedIndex = 0;
      selectedId = items[0].product.id;
      window.lavkaVariantChoice[group] = selectedId;
    }

    const selected = items[selectedIndex];
    const keeper = items[0].card;

    items.slice(1).forEach(x => x.card.remove());

    const title = keeper.querySelector('.product-title');
    const desc = keeper.querySelector('.product-desc');
    const price = keeper.querySelector('.price');
    const add = keeper.querySelector('[data-add]');
    const body = keeper.querySelector('.product-body');
    const priceRow = keeper.querySelector('.price-row');
    const img = keeper.querySelector('.product-img');

    if(title) title.textContent = selected.product.name || '';
    if(desc) desc.textContent = selected.meta.short || '';
    if(price) price.textContent = rub(selected.product.price);

    if(img){
      img.src = selected.product.image_url || '/logo.jpg';
    }

    if(add){
      add.dataset.add = selected.product.id;
      add.disabled = Number(selected.product.stock || 0) < 1;
    }

    const oldSelector = keeper.querySelector('.lv4-shop-variant');
    if(oldSelector) oldSelector.remove();

    if(body && priceRow){
      const selector = document.createElement('div');
      selector.className = 'lv4-shop-variant';

      const encodedGroup = encodeURIComponent(group);

      selector.innerHTML = `
        <button
          type="button"
          class="lv4-shop-arrow"
          data-lv4-shift="-1"
          data-lv4-group="${encodedGroup}"
          ${selectedIndex === 0 ? 'disabled' : ''}>
          ‹
        </button>

        <div class="lv4-shop-size">
          ${esc(lv4ShopLabel(selected.meta))}
        </div>

        <button
          type="button"
          class="lv4-shop-arrow"
          data-lv4-shift="1"
          data-lv4-group="${encodedGroup}"
          ${selectedIndex === items.length - 1 ? 'disabled' : ''}>
          ›
        </button>
      `;

      body.insertBefore(selector, priceRow);
    }
  });

  const catalogHead = [...document.querySelectorAll('#content .section-head')]
    .find(x => x.querySelector('h2')?.textContent.trim() === 'Каталог');

  if(catalogHead){
    const count = catalogHead.querySelector('.muted');
    if(count){
      count.textContent =
        grid.querySelectorAll('.card').length + ' поз.';
    }
  }
}

if(!window.lv4StorefrontClickBound){
  window.lv4StorefrontClickBound = true;

  document.addEventListener('click', e => {
    const btn = e.target.closest('[data-lv4-shift]');
    if(!btn) return;

    e.preventDefault();
    e.stopPropagation();

    const group = decodeURIComponent(btn.dataset.lv4Group || '');
    const shift = Number(btn.dataset.lv4Shift || 0);

    const variants = (state.boot?.products || [])
      .filter(p => lv4meta(p).group === group)
      .sort((a,b) =>
        Number(lv4meta(a).amount || 0) -
        Number(lv4meta(b).amount || 0)
      );

    if(!variants.length) return;

    const currentId = window.lavkaVariantChoice[group];

    let index = variants.findIndex(
      p => String(p.id) === String(currentId)
    );

    if(index < 0) index = 0;

    index = Math.max(
      0,
      Math.min(variants.length - 1, index + shift)
    );

    window.lavkaVariantChoice[group] = variants[index].id;

    render();
  });
}

const lv4OriginalRender = render;

render = function(){
  lv4OriginalRender();

  if(state.tab === 'shop'){
    lv4ApplyGroupedStorefront();
  }
};

