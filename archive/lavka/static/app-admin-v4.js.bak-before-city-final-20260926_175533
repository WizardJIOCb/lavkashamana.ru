
/* LAVKA_CATEGORY_ICONS_V1 */
function lavkaCategoryIcon(c){
  function byName(name){
    const n = String(name || '').toLowerCase().replace(/ё/g, 'е');
    if (/гриб|мухомор|сома/.test(n)) return '🍄';
    if (/мед|пчел|прополис/.test(n)) return '🍯';
    if (/трав|иван.?чай|саган/.test(n)) return '🌿';
    if (/чай|чаи|чаев|пуэр|улун/.test(n)) return '🍵';
    return '';
  }
  const own = byName(c?.name);
  if (own) return own;
  const root = c ? categoryRoot(c) : null;
  return byName(root?.name) || '🛍️';
}
function lavkaSetCategoryIcons(){
  document.querySelectorAll('.pill[data-cat]').forEach(button => {
    const id = button.dataset.cat;
    const category = (state.boot?.categories || []).find(
      c => String(c.id) === id
    );
    button.dataset.categoryIcon =
      id === 'all' ? '🛍️' : lavkaCategoryIcon(category);
  });
}


/* LAVKA_PRODUCT_LABELS_V1 */
function lavkaDisplayMeta(p){
  const raw = String(p?.description || '');
  const matches = [...raw.matchAll(
    /\[\[(LV4|VARIANT):([^|\]]+)\|([0-9.]+)\|(g|ml|pcs)\]\]/g
  )];
  const m = matches.find(x => x[1] === 'LV4') || matches[0];
  const amount = m ? Number(m[3]) : NaN;
  const units = {g:'г', ml:'мл', pcs:'шт.'};
  const label = m && Number.isFinite(amount) && amount > 0
    ? new Intl.NumberFormat('ru-RU', {
        maximumFractionDigits: 10
      }).format(amount) + ' ' + units[m[4]]
    : '';
  return {
    label,
    description: raw.replace(
      /\[\[(?:LV4|VARIANT):[^\]]*\]\]/g, ''
    ).trim()
  };
}
function lavkaDisplayName(p){
  const name = String(p?.name || '');
  const label = lavkaDisplayMeta(p).label;
  return label ? name + ' · ' + label : name;
}

