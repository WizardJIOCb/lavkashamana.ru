/* LAVKA_PRODUCT_INFO_V2_START */

function lavkaOpenProductDetailsV2(productId){

  const base=(state.boot?.products||[]).find(
    p=>Number(p.id)===Number(productId)
  );

  if(!base) return;

  const bm=lv4meta(base);

  const variants=bm.group
    ? (state.boot.products||[])
        .filter(p=>lv4meta(p).group===bm.group)
        .sort((a,b)=>
          Number(lv4meta(a).amount||0)-
          Number(lv4meta(b).amount||0)
        )
    : [base];

  let index=variants.findIndex(
    p=>Number(p.id)===Number(productId)
  );

  if(index<0) index=0;

  const d=modal(`
    <div class="lavka-product-details-v2">

      <div class="section-head">
        <h2 id="detailV2Name"></h2>
        <button class="btn secondary" id="detailV2Close">
          Закрыть
        </button>
      </div>

      <img
        id="detailV2Image"
        class="detail-v2-image"
        src="/logo.jpg">

      <div
        id="detailV2Text"
        class="detail-v2-text">
      </div>

      <div
        id="detailV2Variants"
        class="detail-v2-variants">
      </div>

      <div class="detail-v2-buy">
        <div id="detailV2Price" class="detail-v2-price"></div>

        <button class="btn gold" id="detailV2Add">
          В корзину
        </button>
      </div>

    </div>
  `);

  function label(meta){
    if(typeof lv4ShopLabel==='function'){
      return lv4ShopLabel(meta);
    }

    const units={g:'г',ml:'мл',pcs:'шт.'};
    return `${meta.amount||''} ${units[meta.unit]||''}`;
  }

  function draw(){
    const p=variants[index];
    const m=lv4meta(p);

    d.querySelector('#detailV2Name').textContent=p.name||'';

    const img=d.querySelector('#detailV2Image');
    img.src=p.image_url||'/logo.jpg';
    img.onerror=()=>img.src='/logo.jpg';

    d.querySelector('#detailV2Text').textContent=
      m.description||'Подробное описание пока не добавлено.';

    d.querySelector('#detailV2Price').textContent=rub(p.price);

    const vb=d.querySelector('#detailV2Variants');

    if(variants.length>1){
      vb.innerHTML=`
        <button
          type="button"
          class="lv4-shop-arrow"
          id="detailV2Prev"
          ${index===0?'disabled':''}>
          ‹
        </button>

        <div class="lv4-shop-size">
          ${esc(label(m))}
        </div>

        <button
          type="button"
          class="lv4-shop-arrow"
          id="detailV2Next"
          ${index===variants.length-1?'disabled':''}>
          ›
        </button>
      `;

      d.querySelector('#detailV2Prev').onclick=()=>{
        if(index>0){
          index--;
          draw();
        }
      };

      d.querySelector('#detailV2Next').onclick=()=>{
        if(index<variants.length-1){
          index++;
          draw();
        }
      };

    }else{
      vb.innerHTML=label(m)
        ? `<div class="lv4-shop-size">${esc(label(m))}</div>`
        : '';
    }

    const add=d.querySelector('#detailV2Add');
    add.disabled=Number(p.stock||0)<1;
    add.textContent=add.disabled?'Нет в наличии':'В корзину';

    add.onclick=()=>{
      if(add.disabled) return;

      if(bm.group && window.lavkaVariantChoice){
        window.lavkaVariantChoice[bm.group]=p.id;
      }

      addCart(Number(p.id));

      add.textContent='Добавлено ✓';

      setTimeout(()=>{
        if(document.body.contains(add) && !add.disabled){
          add.textContent='В корзину';
        }
      },1000);
    };
  }

  d.querySelector('#detailV2Close').onclick=()=>d.remove();

  draw();
}

