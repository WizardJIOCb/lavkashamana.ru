/* LAVKA_NESTED_CATEGORIES_V1 */

function categoryDepth(c){
  return String(c?.slug || '').split('--').filter(Boolean).length || 1;
}

function categoryParent(c){
  const slug = String(c?.slug || '');
  if(!slug.includes('--')) return null;

  const parentSlug = slug.split('--').slice(0,-1).join('--');

  return (state.boot?.categories || []).find(x =>
    String(x.slug || '') === parentSlug
  ) || null;
}

function categoryRoot(c){
  let cur = c;
  let p;

  while(cur && (p = categoryParent(cur))){
    cur = p;
  }

  return cur;
}

function categoryChildren(c){
  if(!c) return [];

  const prefix = String(c.slug || '') + '--';

  return (state.boot?.categories || []).filter(x => {
    const slug = String(x.slug || '');

    if(!slug.startsWith(prefix)) return false;

    const rest = slug.slice(prefix.length);

    return rest && !rest.includes('--');
  });
}

function categoryDescendantIds(c){
  if(!c) return [];

  const slug = String(c.slug || '');
  const prefix = slug + '--';

  return (state.boot?.categories || [])
    .filter(x => {
      const xs = String(x.slug || '');
      return xs === slug || xs.startsWith(prefix);
    })
    .map(x => Number(x.id));
}

function categoryBaseSlug(c){
  const slug = String(c?.slug || '');
  return slug.split('--').filter(Boolean).pop() || '';
}

function sortedCategories(){
  return [...(state.boot?.categories || [])].sort((a,b) => {
    const da = categoryDepth(a);
    const db = categoryDepth(b);

    if(da !== db) return da - db;

    return String(a.slug || '').localeCompare(
      String(b.slug || ''),
      'ru'
    );
  });
}

function shopView(){
  const cats = state.boot.categories || [];
  const roots = cats.filter(c => categoryDepth(c) === 1);

  const selected =
    state.category === 'all'
      ? null
