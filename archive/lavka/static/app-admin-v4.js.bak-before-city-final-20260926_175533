/* LAVKA_FAQ_V1_START */

function lavkaFaqParse(raw){
  try{
    const rows=JSON.parse(raw||'[]');
    return Array.isArray(rows)?rows:[];
  }catch(_){
    return [];
  }
}

function lavkaFaqPublicHtml(raw){
  const rows=lavkaFaqParse(raw)
    .filter(x=>x && x.active!==false && String(x.question||'').trim())
    .sort((a,b)=>
      Number(a.sort_order||0)-Number(b.sort_order||0) ||
      Number(a.id||0)-Number(b.id||0)
    );

  if(!rows.length){
    return '<div class="empty">Раздел пока не заполнен.</div>';
  }

  const groups=new Map();

  rows.forEach(x=>{
    const category=String(x.category||'Общие вопросы').trim() || 'Общие вопросы';

    if(!groups.has(category)){
      groups.set(category,[]);
    }

    groups.get(category).push(x);
  });

  return [...groups.entries()].map(([category,items])=>`
    <div class="faq-category">
      <div class="faq-category-title">${esc(category)}</div>

      ${items.map(x=>`
        <details class="faq-question">
          <summary>${esc(x.question)}</summary>
          <div class="faq-answer">${esc(x.answer||'')}</div>
        </details>
      `).join('')}
    </div>
  `).join('');
}



async function openFaqEditor(){
  try{
    const settings = await api('/api/admin/settings');

    let rows = lavkaFaqParse(settings.faq_data);

    const d = modal(`
      <div class="section-head">
        <div>
          <div class="eyebrow">УПРАВЛЕНИЕ</div>
          <h2>FAQ</h2>
        </div>

        <button class="btn secondary" id="faqClose">
          Закрыть
        </button>
      </div>

      <button
        class="btn gold"
        id="faqAdd"
        style="width:100%;margin:8px 0 16px">
        + Добавить вопрос
      </button>

      <div id="faqAdminList"></div>
    `);

    const list = d.querySelector('#faqAdminList');

    d.querySelector('#faqClose').onclick = () => d.remove();

    async function saveAll(){
      await api('/api/admin/settings',{
        method:'PATCH',
        body:JSON.stringify({
          values:{
            faq_data:JSON.stringify(rows)
          }
        })
      });
    }

    function render(){
      const sorted = [...rows].sort((a,b)=>
        Number(a.sort_order||0) - Number(b.sort_order||0) ||
        Number(a.id||0) - Number(b.id||0)
      );

      if(!sorted.length){
        list.innerHTML = `
          <div class="empty" style="padding:22px 10px">
            Пока нет ни одного вопроса.<br><br>
            Нажмите "+ Добавить вопрос".
          </div>
        `;
        return;
      }

      list.innerHTML = `
        <div class="admin-list">
          ${sorted.map(item=>`
            <button
              type="button"
              class="faq-edit-card"
              data-faq-id="${item.id}">

              <div class="faq-edit-main">
                <strong>
                  ${esc(item.question || 'Без названия')}
                </strong>

                <div class="muted">
                  ${esc(item.category || 'Общие вопросы')}
                  · порядок ${Number(item.sort_order||0)}
                  · ${item.active===false ? 'скрыт' : 'показывается'}
                </div>
              </div>

              <div class="faq-edit-arrow">›</div>
            </button>
          `).join('')}
        </div>
      `;

      list.querySelectorAll('[data-faq-id]').forEach(btn=>{
        btn.onclick = ()=>{
          const item = rows.find(
            x => String(x.id) === String(btn.dataset.faqId)
          );

          if(item) openForm(item);
        };
      });
    }

    function openForm(existing=null){
      const isNew = !existing;

      const item = existing || {
        id: Date.now(),
        category: '',
        question: '',
        answer: '',
        sort_order: rows.length
          ? Math.max(...rows.map(x=>Number(x.sort_order||0))) + 10
          : 10,
        active: true
      };

      const form = modal(`
        <div class="section-head">
          <h2>${isNew ? 'Новый вопрос' : 'Редактировать вопрос'}</h2>

          <button class="btn secondary" id="faqFormClose">
            Закрыть
          </button>
        </div>

        <div class="form">

          <div class="field">
            <label>Категория</label>
            <input
              id="faqCategory"
              value="${esc(item.category||'')}"
              placeholder="Например: Грибная продукция, Чаи, Заказы">
          </div>

          <div class="field">
            <label>Вопрос</label>
            <textarea
              id="faqQuestion"
              rows="3"
              placeholder="Напишите вопрос"
            >${esc(item.question||'')}</textarea>
          </div>

          <div class="field">
            <label>Ответ</label>
            <textarea
              id="faqAnswer"
              rows="8"
              placeholder="Напишите полный ответ"
            >${esc(item.answer||'')}</textarea>
          </div>

          <div class="field">
            <label>Порядок отображения</label>
            <input
              id="faqOrder"
              type="number"
              value="${Number(item.sort_order||0)}">
          </div>

          <label class="faq-active-row">
            <input
              id="faqActive"
              type="checkbox"
              ${item.active!==false ? 'checked' : ''}>
            <span>Показывать покупателям</span>
          </label>

          <button
            class="btn gold"
            id="faqSave"
            style="width:100%">
            Сохранить
          </button>

          ${isNew ? '' : `
            <button
              class="btn secondary"
              id="faqDelete"
              style="width:100%;margin-top:10px">
              Удалить вопрос
            </button>
          `}

        </div>
      `);

      form.querySelector('#faqFormClose').onclick = ()=>form.remove();

      form.querySelector('#faqSave').onclick = async ()=>{
        try{
          const category =
            form.querySelector('#faqCategory').value.trim();

          const question =
            form.querySelector('#faqQuestion').value.trim();

          const answer =
            form.querySelector('#faqAnswer').value.trim();

          const sort_order =
            Number(form.querySelector('#faqOrder').value || 0);

          const active =
            form.querySelector('#faqActive').checked;

          if(!question){
            toast('Напиши вопрос');
            return;
          }

          if(!answer){
            toast('Напиши ответ');
            return;
          }

          item.category = category || 'Общие вопросы';
          item.question = question;
          item.answer = answer;
          item.sort_order = sort_order;
          item.active = active;

          if(isNew){
            rows.push(item);
          }

          await saveAll();

          form.remove();
          render();

          toast('Вопрос сохранён');

        }catch(e){
          toast(e.message);
        }
      };

      const del = form.querySelector('#faqDelete');

      if(del){
        del.onclick = async ()=>{
          if(!confirm('Удалить этот вопрос?')) return;

          rows = rows.filter(
            x => String(x.id) !== String(item.id)
          );

          await saveAll();

          form.remove();
          render();

          toast('Вопрос удалён');
        };
      }
    }

    d.querySelector('#faqAdd').onclick = ()=>openForm();

    render();

  }catch(e){
    toast('FAQ: ' + e.message);
  }
}

/* LAVKA_FAQ_V1_END */

