      }

      let baseSlug = $('#cSlug').value.trim();

      baseSlug = baseSlug
        .replace(/--+/g,'-')
        .replace(/^-+|-+$/g,'');

      if(!baseSlug){
        throw new Error('Slug не создан');
      }

      const parentId = $('#cParent').value
        ? Number($('#cParent').value)
        : null;

      const parent = parentId
        ? state.boot.categories.find(x =>
            Number(x.id) === Number(parentId)
          )
        : null;

      const fullSlug = parent
        ? `${parent.slug}--${baseSlug}`
        : baseSlug;

      const oldSlug = String(c.slug || '');

      const body = {
        name,
        slug: fullSlug,
        sort_order: Number($('#cSort').value || 0),
        active: true
      };

      await api(
        c.id
          ? `/api/admin/categories/${c.id}`
          : '/api/admin/categories',
        {
          method: c.id ? 'PUT' : 'POST',
          body: JSON.stringify(body)
        }
      );

      /*
        Если поменяли slug родительской категории,
        автоматически обновляем пути её подразделов.
      */
      if(c.id && oldSlug && oldSlug !== fullSlug){

        const descendants = state.boot.categories.filter(x =>
          Number(x.id) !== Number(c.id) &&
          String(x.slug || '').startsWith(oldSlug + '--')
        );

        for(const child of descendants){

          const childSlug =
            fullSlug +
            String(child.slug).slice(oldSlug.length);

          await api(
            `/api/admin/categories/${child.id}`,
            {
              method:'PUT',
              body:JSON.stringify({
                name: child.name,
                slug: childSlug,
                sort_order: Number(child.sort_order || 0),
                active: child.active !== false
              })
            }
          );
        }
      }

      d.remove();
      await boot();
      toast('Категория сохранена');

    }catch(e){
      toast(e.message);
    }
  };
