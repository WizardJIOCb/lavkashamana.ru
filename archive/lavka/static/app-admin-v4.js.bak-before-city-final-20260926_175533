async function lavkaLoadProductDocuments(){
  const box = document.getElementById('productDocuments');
  if(!box) return;

  try{
    const rows = await api('/api/product-documents');

    if(!rows.length){
      box.innerHTML = `
        <div class="empty">
          Документы пока не загружены.
        </div>
      `;
      return;
    }

    box.innerHTML = `
      <div class="lavka-doc-grid">
        ${rows.map((d, i) => {
          const url = '/document/' + encodeURIComponent(d.filename);

          if(d.type === 'pdf'){
            return `
              <button
                type="button"
                class="lavka-doc-card"
                data-doc-pdf="${esc(url)}">

                <div class="lavka-doc-pdf-icon">PDF</div>

                <div class="lavka-doc-name">
                  ${esc(d.title)}
                </div>

                <div class="muted lavka-doc-open">
                  Открыть документ
                </div>
              </button>
            `;
          }

          return `
            <button
              type="button"
              class="lavka-doc-card"
              data-doc-image="${esc(url)}"
              data-doc-title="${esc(d.title)}">

              <img
                class="lavka-doc-thumb"
                src="${esc(url)}"
                alt="${esc(d.title)}">

              <div class="lavka-doc-name">
                ${esc(d.title)}
              </div>

              <div class="muted lavka-doc-open">
                Нажмите для просмотра
              </div>
            </button>
          `;
        }).join('')}
      </div>
    `;

    box.querySelectorAll('[data-doc-image]').forEach(btn => {
      btn.onclick = () => {
        const url = btn.dataset.docImage;
        const title = btn.dataset.docTitle || 'Документ';

        const d = modal(`
          <div class="section-head">
            <h2>${esc(title)}</h2>
            <button class="btn secondary" id="closeDoc">
              Закрыть
            </button>
          </div>

          <img
            src="${esc(url)}"
            alt="${esc(title)}"
            style="
              width:100%;
              height:auto;
              display:block;
              border-radius:16px;
              background:white;
            ">
        `);

        d.querySelector('#closeDoc').onclick = () => d.remove();
      };
    });

    box.querySelectorAll('[data-doc-pdf]').forEach(btn => {
      btn.onclick = () => {
        const url = location.origin + btn.dataset.docPdf;

        if(window.Telegram?.WebApp?.openLink){
          window.Telegram.WebApp.openLink(url);
        }else{
          window.open(url, '_blank');
        }
      };
    });

  }catch(e){
    box.innerHTML = `
      <div class="empty">
        Не удалось загрузить документы.
      </div>
    `;
  }
}

