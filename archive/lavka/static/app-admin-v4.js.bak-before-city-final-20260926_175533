  function renderPvz(){
    const select=$('#coPvz');
    const search=$('#coPvzSearch');
    const hint=$('#pvzHint');

    let results=$('#pvzResults');

    if(!results){
      hint.insertAdjacentHTML(
        'afterend',
        '<div id="pvzResults" class="pvz-results"></div>'
      );

      results=$('#pvzResults');
    }

    const selected=String(select.value||'');
    const query=normalizePvz(search.value);
    const words=query.split(' ').filter(Boolean);

    const found=words.length
      ? pvzRows.filter(x=>
          words.every(w=>pvzSearchText(x).includes(w))
        )
      : [];

    const shown=found.slice(0,15);

    const saved=pvzRows.find(
      x=>String(x.code)===selected
    );

    /*
      Старый select оставляем технически.
      Он нужен существующему оформлению заказа,
      но пользователь его больше не видит.
    */
    select.replaceChildren(
      new Option('Выберите ПВЗ','')
    );

    const optionRows=[];

    if(saved){
      optionRows.push(saved);
    }

    shown.forEach(x=>{
      if(!optionRows.some(
        y=>String(y.code)===String(x.code)
      )){
        optionRows.push(x);
      }
    });

    optionRows.forEach(x=>{
      select.add(new Option(
        [x.code,x.name,x.location?.address]
          .filter(Boolean)
          .join(' · '),
        String(x.code)
      ));
    });

    if(saved){
      select.value=selected;
    }

    if(saved){
      hint.innerHTML=`
        <div class="pvz-selected">
          <div class="pvz-selected-label">
            Выбран пункт СДЭК
          </div>

          <strong>
            ${esc(saved.location?.address || saved.name || saved.code)}
          </strong>

          <div class="muted">
            ${esc(saved.code || '')}
          </div>
        </div>
      `;
    }else if(!city?.code){
      hint.textContent='Сначала выберите город.';
    }else if(!words.length){
      hint.textContent='Начните вводить улицу, дом или код пункта.';
    }else if(!found.length){
      hint.textContent=
        'Пункты по этому запросу не найдены. Попробуйте ввести часть улицы или адреса.';
    }else{
      hint.textContent=
        `Найдено пунктов: ${found.length}. Выберите нужный ниже.`;
    }

    if(!words.length){
      results.innerHTML='';
      return;
    }

    if(!shown.length){
      results.innerHTML='';
      return;
    }

    results.innerHTML=shown.map(x=>{
      const address=x.location?.address || '';
      const name=x.name || 'СДЭК';
      const code=x.code || '';
      const isSelected=String(code)===selected;

      return `
        <button
          type="button"
          class="pvz-result ${isSelected?'selected':''}"
          data-pvz-code="${esc(String(code))}">

          <div class="pvz-result-title">
            ${esc(name)}
          </div>

          <div class="pvz-result-address">
            ${esc(address)}
          </div>

          <div class="pvz-result-code">
            Код: ${esc(String(code))}
          </div>

          ${isSelected
            ? '<div class="pvz-result-check">✓ Выбран</div>'
            : ''
          }
        </button>
      `;
    }).join('');

    results
      .querySelectorAll('[data-pvz-code]')
      .forEach(btn=>{
        btn.onclick=()=>{
          const code=String(btn.dataset.pvzCode||'');

          const item=pvzRows.find(
            x=>String(x.code)===code
          );

          if(!item) return;

          if(!Array.from(select.options).some(
            o=>o.value===code
          )){
            select.add(new Option(
              [
                item.code,
                item.name,
                item.location?.address
              ].filter(Boolean).join(' · '),
              code
            ));
          }

          select.value=code;

          /*
            Сохраняем всю старую логику checkout.
          */
          select.dispatchEvent(
            new Event('change',{bubbles:true})
          );

          renderPvz();
        };
      });
  }

  const cleanTariff=v=>String(v)
    .replace(/\s+до\s+\d{1,2}(?:[.:]\d{2}){0,2}/gi,'')
    .replace(/\b\d{1,2}[:.]\d{2}(?:[:.]\d{2})?\b/g,'')
    .replace(/\s{2,}/g,' ').trim();

  $('#coPvzSearch').oninput=renderPvz;

  const renderTariffs=()=>{
    const mode=$('#coType').value;

    const filtered=tariffs.filter(t=>{
      const dm=Number(t.delivery_mode||0);

      return mode==='pickup'
        ? [4].includes(dm)
        : [3].includes(dm);
    });

    $('#coTariff').innerHTML=
      '<option value="">Выберите тариф</option>'+
      filtered.map(t=>`
        <option
          value="${t.tariff_code}"
          data-price="${t.delivery_sum??t.total_sum??0}">
          ${esc(cleanTariff(t.tariff_name||('Тариф '+t.tariff_code)))}
          — ${rub(t.delivery_sum??t.total_sum??0)}
          · ${t.period_min??'?'}–${t.period_max??'?'} дн.
        </option>
      `).join('');
  };


  const updateMode=()=>{
    const pickup=$('#coType').value==='pickup';

    $('#pvzField').classList.toggle('hidden',!pickup);
    $('#addressField').classList.toggle('hidden',pickup);

    renderTariffs();
  };


  async function loadCityData(savedPoint=null){
    pvzRows=[];
    $('#coPvzSearch').value='';
    renderPvz();
    if(!city?.code) return;

    try{
      const qr=await api('/api/cdek/quote',{
        method:'POST',
        body:JSON.stringify({
          items,
          to_city_code:city.code
        })
      });

      tariffs=qr.tariff_codes||[];
      renderTariffs();

      const pvz=await api(
        '/api/cdek/pvz?city_code='+city.code
      );
      pvzRows=Array.isArray(pvz)?pvz:[];
      $('#coPvzSearch').value='';
      renderPvz();

      if(savedPoint){
        const saved=pvzRows.find(x=>String(x.code)===String(savedPoint));
        if(saved){
          const select=$('#coPvz');
          if(!Array.from(select.options).some(o=>o.value===String(saved.code))){
            select.add(new Option(
              [saved.code,saved.name,saved.location?.address].filter(Boolean).join(' · '),
              String(saved.code)
            ));
          }
          select.value=String(saved.code);
          renderPvz();
        }
      }

      $('#deliveryNotice').textContent=
        `Найдено тарифов: ${tariffs.length}. ПВЗ: ${pvz.length}.`;

    }catch(e){
      tariffs=[];
      renderTariffs();

      $('#deliveryNotice').textContent=
        'СДЭК пока не подключён: '+e.message;
    }
  }


  $('#coType').onchange=updateMode;
  updateMode();


  let timer;
  let citySearchSeq=0;

  $('#coCity').oninput=()=>{
    clearTimeout(timer);

    const input=$('#coCity');
    const results=$('#cityResults');
    const q=input.value.trim();

    city=null;

    if(q.length<1){
      results.innerHTML='';
      return;
    }

    const seq=++citySearchSeq;

    timer=setTimeout(async()=>{
      try{
        const rows=await api(
          '/api/cdek/cities?q='+encodeURIComponent(q)
        );

        if(seq!==citySearchSeq) return;

        results.innerHTML='';

        if(!Array.isArray(rows) || !rows.length){
          results.innerHTML=
            '<div class="cdek-city-message">Город не найден</div>';
          return;
        }

        rows.slice(0,10).forEach(c=>{
          if(!c || !c.code || !c.name) return;

          const btn=document.createElement('button');

          btn.type='button';
          btn.className='cdek-city-simple';
          btn.textContent=String(c.name);

          btn.onclick=async()=>{
            city={
              code:Number(c.code),
              name:String(c.name)
            };

            input.value=city.name;
            results.innerHTML='';

            await loadCityData();
          };

          results.appendChild(btn);
        });

      }catch(e){
        if(seq!==citySearchSeq) return;

        results.innerHTML='';

        const msg=document.createElement('div');
        msg.className='cdek-city-message';
        msg.textContent='Ошибка поиска города: '+e.message;

        results.appendChild(msg);
      }

    },250);
  };


  if(city?.code){
    await loadCityData(m.delivery_point||null);
  }


  $('#placeOrder').onclick=async()=>{
    try{
      const pickup=$('#coType').value==='pickup';

      const tariff=
        Number($('#coTariff').value||0)||null;

      const pvz=
        pickup
          ? ($('#coPvz').value||null)
          : null;

      const payload={
        items,

        customer_name:$('#coName').value.trim(),

        phone:$('#coPhone').value.trim(),
        email:$('#coEmail').value.trim(),

        city_code:city?.code||null,

        city_name:
          city?.name ||
          $('#coCity').value.trim() ||
          null,

        delivery_type:$('#coType').value,

        delivery_tariff_code:tariff,

        delivery_point:pvz,

        delivery_total:0,

        address:
          pickup
            ? null
            : ($('#coAddress').value.trim()||null),

        use_balance:Number($('#coBalance').value||0)
      };

      if(!payload.customer_name||!payload.phone||!payload.email){
        throw new Error('Заполни имя, телефон и email для кассового чека');
      }

      if(
        state.boot.integrations.cdek &&
        (!payload.city_code||!payload.delivery_tariff_code)
      ){
        throw new Error('Выбери город и тариф СДЭК');
      }

      if(
        state.boot.integrations.cdek &&
        pickup &&
        !payload.delivery_point
      ){
        throw new Error('Выбери ПВЗ');
      }

      if(
        state.boot.integrations.cdek &&
        !pickup &&
        !payload.address
      ){
        throw new Error('Укажи адрес курьерской доставки');
      }

      const r=await api('/api/orders',{
        method:'POST',
        body:JSON.stringify(payload)
      });

      state.cart={};
      saveCart();

      d.remove();

      if(r.payment_url){
        if(tg?.openLink) tg.openLink(r.payment_url);
        else location.href=r.payment_url;
      }else{
        toast('Заказ создан');
        await boot();
      }

    }catch(e){
      toast(e.message);
    }
  };
}

