:root{
  --paper:#f3ead8;--paper2:#fbf7ef;--ink:#171713;--muted:#716b5f;--gold:#c99135;--line:#d9cbb3;--ok:#2e6f48;--danger:#8a2e2e;
  --shadow:0 14px 38px rgba(32,26,16,.12);--radius:22px;
}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#efe3cf,#f8f1e6 35%,#efe8dc);color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.app-shell{max-width:760px;margin:0 auto;min-height:100vh;padding-bottom:88px}.hero{display:flex;gap:18px;align-items:center;padding:22px 18px 14px}.logo{width:92px;height:92px;object-fit:cover;border-radius:26px;box-shadow:var(--shadow);border:1px solid rgba(0,0,0,.06)}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--gold)}h1{margin:3px 0 6px;font-size:31px;line-height:1}.hero p{margin:0;color:var(--muted);font-size:14px;line-height:1.35}#content{padding:4px 16px 24px}.section{margin:16px 0}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.section-head h2{font-size:20px;margin:0}.muted{color:var(--muted)}.pill-row{display:flex;gap:8px;overflow:auto;padding-bottom:5px}.pill{white-space:nowrap;border:1px solid var(--line);background:rgba(255,255,255,.55);padding:10px 14px;border-radius:999px;font-weight:700}.pill.active{background:var(--ink);color:white;border-color:var(--ink)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:rgba(255,255,255,.72);border:1px solid rgba(123,102,70,.16);border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 24px rgba(38,29,14,.08)}.product-img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#e9dfcd}.product-body{padding:12px}.product-title{font-weight:800;font-size:15px;min-height:38px}.product-desc{font-size:12px;color:var(--muted);line-height:1.35;min-height:34px;margin:6px 0}.price-row{display:flex;justify-content:space-between;align-items:center;gap:8px}.price{font-size:18px;font-weight:900}.btn{border:0;border-radius:14px;background:var(--ink);color:#fff;padding:11px 14px;font-weight:800}.btn.secondary{background:var(--paper);color:var(--ink);border:1px solid var(--line)}.btn.gold{background:var(--gold);color:#fff}.btn.danger{background:var(--danger)}.btn:disabled{opacity:.45}.panel{background:rgba(255,255,255,.72);border:1px solid rgba(123,102,70,.16);border-radius:var(--radius);padding:16px;box-shadow:0 8px 24px rgba(38,29,14,.07)}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{padding:14px;border-radius:18px;background:var(--paper2);border:1px solid var(--line)}.stat strong{display:block;font-size:20px}.stat span{font-size:11px;color:var(--muted)}.bottom-nav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(760px,100%);display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:rgba(248,242,231,.94);backdrop-filter:blur(18px);padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid rgba(0,0,0,.08);z-index:30}.bottom-nav button{border:0;background:transparent;padding:10px 6px;border-radius:14px;font-weight:800;color:var(--muted)}.bottom-nav button.active{background:var(--ink);color:#fff}.hidden{display:none!important}.cart-line{display:grid;grid-template-columns:62px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.cart-line img{width:62px;height:62px;border-radius:14px;object-fit:cover}.qty{display:flex;gap:6px;align-items:center}.qty button{width:30px;height:30px;border-radius:10px;border:1px solid var(--line);background:white;font-weight:900}.form{display:grid;gap:10px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:800;color:var(--muted)}input,textarea,select{width:100%;padding:12px 13px;border-radius:14px;border:1px solid var(--line);background:#fffdf9;font:inherit;color:var(--ink)}textarea{min-height:90px;resize:vertical}.order{padding:12px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}.badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:var(--paper);font-size:11px;font-weight:800}.ref-link{display:flex;gap:8px}.ref-link input{font-size:12px}.notice{padding:12px 14px;border-radius:16px;background:#fff6dd;border:1px solid #e9d29a;font-size:13px;line-height:1.35}.admin-list{display:grid;gap:10px}.admin-row{background:#fffdf9;border:1px solid var(--line);padding:12px;border-radius:16px;display:flex;justify-content:space-between;gap:12px;align-items:center}.admin-actions{display:flex;gap:6px;flex-wrap:wrap}.modal{position:fixed;inset:0;background:rgba(0,0,0,.44);display:flex;align-items:flex-end;justify-content:center;z-index:99}.modal-card{width:min(760px,100%);max-height:88vh;overflow:auto;background:var(--paper2);border-radius:24px 24px 0 0;padding:18px}.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:100px;background:#171713;color:white;padding:12px 16px;border-radius:14px;z-index:100;box-shadow:var(--shadow)}.empty{text-align:center;padding:34px 18px;color:var(--muted)}@media(max-width:420px){.hero{align-items:flex-start}.logo{width:78px;height:78px}.hero h1{font-size:27px}.grid{gap:9px}.product-body{padding:10px}.stat-grid{grid-template-columns:1fr 1fr}.bottom-nav{grid-template-columns:repeat(4,1fr)} }
