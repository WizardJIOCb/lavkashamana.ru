APP_NAME=Лавка шамана
APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./shaman.db

# Telegram
BOT_TOKEN=
BOT_USERNAME=ShamanLavkaBot
ADMIN_TELEGRAM_USERNAME=shamanchik007
# После первого успешного входа админа его numeric Telegram ID сохраняется в БД.
DEV_AUTH=true

# YooKassa (если под "UKSSD" имелась в виду ЮKassa)
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8000/?payment=return

# CDEK API v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_BASE=https://api.cdek.ru
CDEK_FROM_CITY=Октябрьский
CDEK_FROM_REGION=Республика Башкортостан
CDEK_FROM_COUNTRY=RU

# Defaults package fallback, if product dimensions are not specified
DEFAULT_PACKAGE_LENGTH_CM=15
DEFAULT_PACKAGE_WIDTH_CM=20
DEFAULT_PACKAGE_HEIGHT_CM=10
DEFAULT_PRODUCT_WEIGHT_G=200
